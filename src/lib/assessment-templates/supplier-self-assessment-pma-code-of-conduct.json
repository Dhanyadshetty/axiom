  "sections": [
    {
      "key": "buyer_message",
      "title": "Message from the buyer",
      "titleDe": "Nachricht des Käufers",
      "order": 0,
      "blocks": [
        {
          "key": "buyer_message_block",
          "title": "Message from the buyer",
          "titleDe": "Nachricht des Käufers",
          "icon": "message-square",
          "message": "Dear Supplier,\n\nWe are pleased about the opportunity to work with you and kindly ask you to complete this Supplier Self Assessment covering our Product Material Declaration (PMA) requirements and Supplier Code of Conduct.\n\nPlease fill out all sections completely and accurately. Your responses will help us evaluate our supply chain compliance and sustainability commitments.\n\nIf you have any questions, please contact your assigned procurement representative.\n\nKind regards,\n[Buyer Name]\n[Buyer Company]",
          "messageDe": "Sehr geehrte(r) Lieferant(in),\n\nWir freuen uns über die Möglichkeit, mit Ihnen zusammenzuarbeiten, und bitten Sie höflich, diese Lieferanten-Selbstauskunft zu unseren Anforderungen an die Produktmaterialdeklaration (PMA) und den Lieferantenverhaltenskodex auszufüllen.\n\nBitte füllen Sie alle Abschnitte vollständig und korrekt aus. Ihre Angaben helfen uns, die Compliance und Nachhaltigkeitsverpflichtungen unserer Lieferkette zu bewerten.\n\nBei Fragen wenden Sie sich bitte an Ihre(n) zuständige(n) Beschaffungsmitarbeiter(in).\n\nMit freundlichen Grüßen,\n[Name des Käufers]\n[Firma des Käufers]",
          "fields": []
        }
      ]
    },
