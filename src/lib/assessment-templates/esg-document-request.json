{
  "id": "esg_document_request",
  "name": "ESG Dokumentenanfrage",
  "category": "esg_document_request",
  "version": "1.0",
  "description": "Request for ESG-related documents from the supplier.",
  "sections": [
    {
      "key": "buyer_message",
      "title": "Message from the buyer",
      "titleDe": "Nachricht des Käufers",
      "order": 0,
      "blocks": [
        {
          "key": "buyer_message_block",
          "title": "Message from the buyer",
          "titleDe": "Nachricht des Käufers",
          "icon": "message-square",
          "message": "Dear Supplier,\n\nPlease upload the requested ESG documents. This helps us assess your sustainability and compliance posture.\n\nKind regards,\n[Buyer Name]\n[Buyer Company]",
          "messageDe": "Sehr geehrte(r) Lieferant(in),\n\nBitte laden Sie die angeforderten ESG-Dokumente hoch. Dies hilft uns, Ihre Nachhaltigkeits- und Compliance-Position zu bewerten.\n\nMit freundlichen Grüßen,\n[Name des Käufers]\n[Firma des Käufers]",
          "fields": []
        }
      ]
    },
    {
      "key": "supplier_identification",
      "title": "1. Supplier Identification",
      "titleDe": "1. Lieferantenidentifikation",
      "order": 1,
      "blocks": [
        {
          "key": "company_address",
          "title": "Company address",
          "titleDe": "Unternehmensanschrift",
          "icon": "building",
          "fields": [
            { "key": "supplier_number", "label": "Supplier number", "labelDe": "Lieferantennummer", "type": "short_text", "required": false },
            { "key": "company_name", "label": "Company name", "labelDe": "Firmenname", "type": "short_text", "required": true },
            { "key": "address", "label": "Address", "labelDe": "Anschrift", "type": "short_text", "required": true }
          ]
        },
        {
          "key": "primary_contact",
          "title": "Primary contact",
          "titleDe": "Primärkontakt",
          "icon": "user",
          "fields": [
            { "key": "contact_person_name", "label": "Contact name", "labelDe": "Kontaktname", "type": "short_text", "required": false },
            { "key": "contact_email", "label": "Contact email", "labelDe": "Kontakt-E-Mail", "type": "short_text", "required": false }
          ]
        }
      ]
    },
    {
      "key": "esg_documents",
      "title": "2. ESG Documents",
      "titleDe": "2. ESG-Dokumente",
      "order": 2,
      "blocks": [
        {
          "key": "documents",
          "title": "Documents",
          "titleDe": "Dokumente",
          "icon": "file-text",
          "fields": [
            { "key": "amfori_bsci", "label": "amfori BSCI", "labelDe": "amfori BSCI", "type": "document_upload", "required": true },
            { "key": "emas", "label": "EMAS", "labelDe": "EMAS", "type": "document_upload", "required": true },
            { "key": "iatf_16949", "label": "IATF 16949", "labelDe": "IATF 16949", "type": "document_upload", "required": true },
            { "key": "iso_14001", "label": "ISO 14001", "labelDe": "ISO 14001", "type": "document_upload", "required": true },
            { "key": "iso_9001", "label": "ISO 9001", "labelDe": "ISO 9001", "type": "document_upload", "required": true },
            { "key": "sa_8000", "label": "SA 8000", "labelDe": "SA 8000", "type": "document_upload", "required": true },
            { "key": "sedex_smeta", "label": "SEDEX/SMETA", "labelDe": "SEDEX/SMETA", "type": "document_upload", "required": true },
            { "key": "iso_45001", "label": "ISO 45001", "labelDe": "ISO 45001", "type": "document_upload", "required": true },
            { "key": "iso_37001", "label": "ISO 37001", "labelDe": "ISO 37001", "type": "document_upload", "required": true },
            { "key": "code_of_conduct_doc", "label": "Verhaltenskodex (Code of Conduct)", "labelDe": "Verhaltenskodex", "type": "document_review_confirm", "required": true, "templates": [{ "id": "coc_3", "name": "2023-02-01-prettl-code-of-conduct.pdf", "nameDe": "2023-02-01-prettl-code-of-conduct.pdf", "url": "/documents/2023-02-01-prettl-code-of-conduct.pdf" }, { "id": "coc_4", "name": "2023-30-06-code-of-conduct-pma-english.pdf", "nameDe": "2023-30-06-code-of-conduct-pma-english.pdf", "url": "/documents/2023-30-06-code-of-conduct-pma-english.pdf" }] },
            { "key": "comments", "label": "Additional comments", "labelDe": "Zusätzliche Kommentare", "type": "long_text_rich", "required": false }
          ]
        }
      ]
    }
  ]
}